<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>ImageOptCompat</AssemblyName>
    <RootNamespace>ImageOptCompat</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <!-- the free equivalent of the static analysis that caught FGL's defect classes -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>All</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- CA1051: RimWorld's Scribe_Values.Look(ref x) binds FIELDS; properties cannot be passed by ref. -->
    <NoWarn>CA1050;CA1707;CA2211;CA1031;CA1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Portable references: builds on any machine, no local RimWorld install required. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.205">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="PackageRelease" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'" Text="Only Release builds may be packaged." />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\Assemblies" />
  </Target>
</Project>
